# 실제 값은 .env 에 넣으세요 (.env 는 커밋되지 않습니다)
# Supabase > Project Settings > Database > Connection string > Transaction pooler(6543)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
PORT=3200
# JWT 서명용 비밀값. 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<긴-무작위-문자열>
