# 실제 값은 .env 에 넣으세요 (.env 는 커밋되지 않습니다)
# Supabase > Project Settings > Database > Connection string > Transaction pooler(6543)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
PORT=3200
# JWT 서명용 비밀값. 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<긴-무작위-문자열>
# 토스페이먼츠 결제위젯 키 (개발자센터 > API 키). 클라이언트 키는 브라우저에 공개되고, 시크릿 키는 서버에서만 쓴다.
TOSS_CLIENT_KEY=test_gck_<클라이언트-키>
TOSS_SECRET_KEY=test_gsk_<시크릿-키>
# 결제 모드: test 면 토스 결제창 대신 테스트 결제창(실제 인증·출금 없음). 비우면 toss. 배포 환경에서는 비워 두세요.
PAYMENT_MODE=test
