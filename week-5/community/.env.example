# 실제 값은 .env 에 넣으세요 (.env 는 커밋되지 않습니다)
# Supabase > Project Settings > Database > Connection string > Transaction pooler(6543)
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
# JWT 서명용 비밀값. 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<긴-무작위-문자열>
PORT=3000
# 이미지 저장(Supabase Storage)용. Supabase > Project Settings > API Keys > service_role (secret)
# ⚠️ 관리자 키입니다. 서버에만 두고 브라우저 코드·깃에 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# 비워 두면 DATABASE_URL 에서 https://<프로젝트ref>.supabase.co 를 자동으로 만듭니다.
SUPABASE_URL=
